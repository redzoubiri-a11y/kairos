{
  "expo": {
    "name": "Tasale",
    "slug": "tasale",
    "version": "1.0.0",
    "scheme": "tasale",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#084F44"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dz.tasale.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Tasale accède à vos photos pour illustrer votre salle et vos avis."
      }
    },
    "android": {
      "package": "dz.tasale.app",
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#084F44"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#084F44"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tasale accède à vos photos pour illustrer votre salle et vos avis."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": null,
      "supabaseAnonKey": null
    }
  }
}
