{
  "expo": {
    "name": "TruckSpot",
    "slug": "truckspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "truckspot",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dz.truckspot.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TruckSpot utilise votre position pour afficher les camions disponibles autour de vous.",
        "NSPhotoLibraryUsageDescription": "TruckSpot accede a vos photos pour televerser vos documents (RC, patente, carte grise)."
      },
      "config": {
        "googleMapsApiKey": "REPLACE_WITH_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "dz.truckspot.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "useNextNotificationsApi": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TruckSpot utilise votre position pour afficher les camions disponibles autour de vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TruckSpot accede a vos photos pour televerser vos documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F4A521",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
