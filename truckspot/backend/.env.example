# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

# --- Database ---
# Local: docker compose up -d db  (see docker-compose.yml)
DATABASE_URL=postgresql://truckspot:truckspot@localhost:5432/truckspot?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated origins, or * in development
CORS_ORIGINS=*

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Set to true only for local test runs / seeded demos
DISABLE_RATE_LIMIT=false
