# Mode brouillon : bandeau + interdiction d'indexation.
# Le défaut est « brouillon ». Mettre 0 — et seulement 0 — pour publier.
NEXT_PUBLIC_DRAFT=1

# --- Formulaire de contact -------------------------------------------------
# Sans ces trois variables, les demandes sont journalisées au lieu d'être
# envoyées : pratique en développement, à configurer avant la mise en ligne.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Anti-spam (Cloudflare Turnstile) --------------------------------------
# Si TURNSTILE_SECRET_KEY est vide, aucun jeton n'est exigé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
