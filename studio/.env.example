# Kairos Studio — variables d'environnement.
# Copier en .env.local et remplir. Ce fichier-ci ne contient que des noms.

# --- Projet Supabase "studio" (le sien, en écriture) ---
STUDIO_SUPABASE_URL=
# Clé service_role : serveur uniquement, jamais dans un navigateur.
STUDIO_SUPABASE_SERVICE_ROLE_KEY=

# --- Base Kairos / Mida (lecture seule) ---
# Chaîne Postgres du rôle studio_reader, créé par db/kairos/0002_studio_reader.sql.
# Ce rôle ne peut ni écrire ni sortir du schéma studio_read.
# Forme : postgresql://studio_reader:<secret>@db.<ref>.supabase.co:5432/postgres
MIDA_DB_URL=

# --- Claude ---
ANTHROPIC_API_KEY=
# Optionnel : surcharge du modèle de génération de texte.
STUDIO_TEXT_MODEL=

# --- Studio web (app/) ---
# Porte à un seul opérateur, pas une authentification multi-utilisateur : la
# clé service_role ne quitte jamais le serveur, donc aucune policy RLS n'est
# nécessaire pour ce studio-là (voir README, « Choix qui méritent d'être
# discutés »).
STUDIO_WEB_PASSWORD=
# Secret qui signe le cookie de session. Générer avec : openssl rand -hex 32
STUDIO_WEB_SECRET=
