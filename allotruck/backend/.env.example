# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

# --- Database ---
# Local: docker compose up -d db  (see docker-compose.yml)
DATABASE_URL=postgresql://allotruck:allotruck@localhost:5432/allotruck?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated origins, or * in development
CORS_ORIGINS=*

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Set to true only for local test runs / seeded demos
DISABLE_RATE_LIMIT=false

# --- Fraicheur des positions ---
# Delai au-dela duquel un camion sort de la carte faute de nouvelle position.
# Une position figee ne vaut pas une disponibilite : sans cette fenetre, un
# camion apercu une fois resterait affiche comme disponible indefiniment.
# 1440 = 24 h. Un marche tres actif peut descendre a 240 (4 h).
TRUCK_POSITION_TTL_MINUTES=1440

# Delai de grace apres l'heure de depart pendant lequel un trajet planifie reste
# propose dans la recherche. Un transporteur encore en chargement doit pouvoir
# etre rejoint ; un depart d'il y a trois semaines n'a plus rien a y faire.
# Un trajet passe en IN_PROGRESS reste visible quoi qu'il arrive.
TRIP_DEPARTURE_GRACE_HOURS=3

# --- Reinitialisation de mot de passe ---
# Duree de vie du code a six chiffres et nombre d'essais avant blocage.
RESET_CODE_TTL_MINUTES=30
RESET_CODE_MAX_ATTEMPTS=5

# --- Envoi de courriel ---
# log  : ecrit le message dans la sortie standard et le garde en memoire.
#        Convient au developpement : on relit le code sans serveur SMTP.
#        Inutilisable en production, personne ne recoit rien.
# smtp : passe par nodemailer, SMTP_URL est alors obligatoire.
MAIL_DRIVER=log
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.dz:465
MAIL_FROM=AlloTruck <no-reply@allotruck.dz>

# --- Stockage des documents ---
# local : ecrit dans UPLOAD_DIR. Convient en developpement et sur un hote disposant
#         d'un volume persistant. Railway / Render / Fly sans volume effacent les
#         fichiers a chaque redeploiement : utiliser s3 dans ce cas.
# s3    : bucket S3, Cloudflare R2, Scaleway ou MinIO. Le bucket doit rester PRIVE,
#         les documents sont relus via une URL signee de courte duree.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=allotruck-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Notifications push (Expo) ---
# Mettre a false pour desactiver completement l'envoi (les notifications
# in-app et la websocket continuent de fonctionner).
PUSH_ENABLED=true
# Jeton d'acces Expo, recommande en production : https://expo.dev/accounts/[compte]/settings/access-tokens
# EXPO_ACCESS_TOKEN=
# Surchargeable pour viser un service local pendant les tests.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
