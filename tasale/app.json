{
  "expo": {
    "name": "Tasale",
    "slug": "tasale",
    "version": "1.0.0",
    "scheme": "tasale",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B6E5F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dz.tasale.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Tasale accède à vos photos pour illustrer votre salle et vos avis."
      }
    },
    "android": {
      "package": "dz.tasale.app",
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tasale accède à vos photos pour illustrer votre salle et vos avis."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": null,
      "supabaseAnonKey": null
    }
  }
}
