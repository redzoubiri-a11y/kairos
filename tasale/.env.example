# ─────────────────────────────────────────────────────────────
# Mawsim — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
#
# Si ces deux variables sont absentes, l'application démarre en
# MODE DÉMO : un backend local (AsyncStorage) pré-rempli avec des
# salles algériennes prend le relais. Aucun compte requis.
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Numéro CCP affiché aux clients pour le versement des acomptes
EXPO_PUBLIC_SUPPORT_PHONE=+213 555 00 00 00
